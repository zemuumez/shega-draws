DATABASE_URL=postgres://rimna:local-development-only@localhost:55437/rimna?sslmode=disable
DB_MAX_CONNECTIONS=20
APP_ENV=development
LISTEN_ADDR=:8080
PROCESS_ROLE=all
WEB_ORIGIN=http://localhost:3000
AUTH_ISSUER=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_AUDIENCE=rimna-api
CHAPA_MODE=test
CHAPA_CURRENCIES=ETB
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
MEDIA_DIR=./private-media

# Optional: only the actual reverse-proxy network; proxy must overwrite X-Real-IP.
TRUSTED_PROXY_CIDRS=

# At least 32 random characters; leave empty to disable metrics.
# Prometheus must use the same value from its credentials file.
METRICS_TOKEN=
# Alternatively mount a secret file; it takes precedence over METRICS_TOKEN.
METRICS_TOKEN_FILE=

# Wallet deposit pilot: disabled by default and test-mode only for this increment.
# Set explicitly approved test limits in minor units before enabling checkout.
DEPOSITS_ENABLED=false
DEPOSIT_MIN_MINOR=0
DEPOSIT_MAX_MINOR=0
# Shared across API/worker instances; confirm provider quotas before launch.
PAYMENT_VERIFY_PER_MINUTE=60
