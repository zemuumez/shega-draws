# Store the real file outside the repository, mode 0600, owned by the operator.
OPS_DATABASE_URL=postgresql://backup_operator@127.0.0.1/rimna
MEDIA_DIR=/srv/rimna/private-media
# An external encrypted repository; initialize once with restic init.
RESTIC_REPOSITORY=s3:https://your-storage-endpoint/your-private-bucket/rimna
RESTIC_PASSWORD_FILE=/etc/rimna/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Restore only: a NEW empty database, isolated from all running applications.
RESTORE_DATABASE_URL=
