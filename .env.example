# Copy into frontend/.env.local for local development.
# Set these same variables on Vercel (Root Directory: frontend), then redeploy.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only token with write access. Never prefix this with NEXT_PUBLIC_.
SANITY_API_TOKEN=
