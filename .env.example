# ─────────────────────────────────────────────
# GO BACKEND
# ─────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080

# PostgreSQL
POSTGRES_USER=shega
POSTGRES_PASSWORD=shegadraws
POSTGRES_DB=shega_draws
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://shega:shegadraws@localhost:5432/shega_draws?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redispass
REDIS_DB=0

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h

# Admin Seed (bcrypt hash — generate with: htpasswd -bnBC 12 "" yourpassword | tr -d ':\n')
SUPERADMIN_PHONE=+251911000000
SUPERADMIN_PASSWORD_HASH=$2a$12$placeholder.replace.me.with.real.hash

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=shega-draws-proofs
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true      # true for MinIO, false for AWS S3
S3_PRESIGN_EXPIRY=15m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limits
RATE_LIMIT_GLOBAL=100          # req/min per IP
RATE_LIMIT_AUTH=5              # req/15min per IP for /auth/login
RATE_LIMIT_ENTRY_SUBMIT=3      # req/10min per IP for POST /entries

# ─────────────────────────────────────────────
# NEXT.JS FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# MinIO / S3 (for MinIO console)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
