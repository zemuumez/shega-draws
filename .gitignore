# ══════════════════════════════════════════════
# Shega Draws — .gitignore
# ══════════════════════════════════════════════

# ── Go ──────────────────────────────────────
backend/bin/
backend/tmp/
*.test

# ── JWT Keys (NEVER commit) ──────────────────
backend/keys/

# ── Node / Next.js ──────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# ── Environment files ────────────────────────
.env
.env.local

# ── OS / Editor ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Docker volumes (if local) ────────────────
pgdata/
redisdata/
miniodata/

# ── Local run & architecture guides ──────────
RUN_GUIDE.md
SYSTEM_ARCHITECTURE_GUIDE.md


# Isolated local production verification
frontend/.next-verify/

# Backend private configuration and verification outputs
backend/.env
backend/private-media/
frontend/.next-*/
frontend/tsconfig.tsbuildinfo

# Operational secrets and Python runtime files
backend/ops/**/secrets/
backend/ops/__pycache__/
